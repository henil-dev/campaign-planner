{
  "name": "campaign-planner",
  "version": "1.0.0",
  "description": "Turn a product, an audience and a budget into a campaign plan: ideas, ad copy, channel split and an A/B test plan that fits the budget.",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "docs": "node scripts/build-docs.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "build:claude": "node scripts/build-claude.mjs",
    "package": "node scripts/package-submission.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "express": "^4.22.3"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  },
  "devDependencies": {
    "marked": "^14.1.4"
  }
}
